type edgefixd, domain;
type edgefixd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(edgefixd)

allow edgefixd sysfs:dir search;
allow edgefixd sysfs:file { open read write getattr };
allow edgefixd proc:dir search;
allow edgefixd proc:file { open read write getattr };
allow edgefixd kmsg_device:chr_file { open read };
allow edgefixd self:capability syslog;

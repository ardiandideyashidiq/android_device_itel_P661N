on early-init
    # boot perf. tune - pin all cores to max during boot
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 2000000
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq 2400000
    write /sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq 4266000000

on charger
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq 0
    write /sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq 0

    chmod 0660 /dev/spm
    chown system system /dev/spm
    start spm_script
    chmod 0666 /dev/kmsg
    chmod 0775 /mnt/vendor
    mkdir /mnt/vendor/nvcfg
    mount ext4 /dev/block/by-name/nvcfg /mnt/vendor/nvcfg rw wait
    chown system system /mnt/vendor/nvcfg
    chmod 0771 /mnt/vendor/nvcfg
    restorecon_recursive /mnt/vendor/nvcfg
    write /sys/devices/platform/battery_meter/FG_daemon_log_level 7
    write /sys/bus/platform/devices/battery/FG_daemon_log_level 7

    # Permissions for System Server and daemons.
    chown system system /sys/power/autosleep
    chown system system /sys/power/state
    chown system system /sys/power/wakeup_count
    chown radio wakelock /sys/power/wake_lock
    chown radio wakelock /sys/power/wake_unlock
    chmod 0660 /sys/power/state
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock
    chmod 0660 /sys/power/wakeup_count
    write /sys/power/pm_freeze_timeout 2000

    start fuelgauged
    start fuelgauged_nvram

    chown system system /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/green/brightness

    chown system system /dev/graphics/fb0
    chown system system /dev/dri/card0

    # Lock to lowest frequency on charger mode
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor powersave
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor powersave

    # Offline all cores except cpu0
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
    write /sys/devices/system/cpu/cpu4/online 0
    write /sys/devices/system/cpu/cpu5/online 0
    write /sys/devices/system/cpu/cpu6/online 0
    write /sys/devices/system/cpu/cpu7/online 0

    start vendor.light-default

    # Stop bootprof
    write /proc/bootprof "0"

on property:vendor.all.modules.ready=1
    # Use sugov_ext (MTK extended schedutil) for better performance
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "sugov_ext"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "sugov_ext"

    # MTK exposes the schedutil rate limit as a single global node here
    # (per-governor up/down_rate_limit_us do not exist on this device).
    # 200us up-limit = very fast freq ramp for responsiveness.
    write /sys/devices/system/cpu/cpufreq/schedutil/rate_limit_us 200

on init
    # Set PELT multiplier to 4 (8ms half-life) for faster response
    write /proc/sys/kernel/sched_pelt_multiplier 4

    write /sys/devices/platform/11270000.ufshci/clkgate_enable 0
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0

    # update cpus for cpuset cgroup - aggressive pinning
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/foreground_window/cpus 0-7
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/foreground/boost/cpus 0-7
    write /dev/cpuset/anibooster/cpus 0-5

    # Aggressive scheduler tuning for responsiveness
    write /proc/sys/kernel/sched_migration_cost_ns 100000
    write /proc/sys/kernel/sched_latency_ns 2000000
    write /proc/sys/kernel/sched_min_granularity_ns 1000000
    write /proc/sys/kernel/sched_wakeup_granularity_ns 1000000
    write /proc/sys/kernel/sched_nr_migrate 16
    write /proc/sys/kernel/sched_child_runs_first 1

    # Mali GPU sysfs nodes for libperfmgr (powerhint.json)
    chown system system /sys/devices/platform/13000000.mali/js_ctx_scheduling_mode
    chmod 0666 /sys/devices/platform/13000000.mali/js_ctx_scheduling_mode
    chown system system /sys/devices/platform/13000000.mali/js_scheduling_period
    chmod 0666 /sys/devices/platform/13000000.mali/js_scheduling_period
    chown system system /sys/devices/platform/13000000.mali/dvfs_period
    chmod 0666 /sys/devices/platform/13000000.mali/dvfs_period

    # GPU DVFS tuning for performance
    write /sys/kernel/ged/hal/fastdvfs_mode 0
    write /sys/kernel/ged/hal/dvfs_margin_value 150
    write /sys/kernel/ged/hal/dvfs_workload_mode 0
    write /sys/kernel/ged/hal/loading_window_size 4
    write /sys/kernel/ged/hal/loading_stride_size 1
    write /sys/kernel/ged/hal/fallback_interval 30

    # FPSGO/FBT tuning for frame-aware performance
    write /sys/kernel/fpsgo/fbt/enable_ceiling 1
    write /sys/kernel/fpsgo/fbt/enable_switch_cap_margin 1
    write /sys/kernel/fpsgo/fbt/blc_boost 1
    write /sys/kernel/fpsgo/fbt/boost_ta 1
    write /sys/kernel/fpsgo/fbt/switch_idleprefer 1
    write /sys/kernel/fpsgo/fbt/llf_task_policy 1
    write /sys/kernel/fpsgo/fbt/ultra_rescue 1

on post-fs-data
    # ZRAM setup - aggressive compression
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0
    write /sys/kernel/mm/swap/vma_ra_enabled true

    # Memory tuning for performance
    write /proc/sys/vm/watermark_boost_factor 15000
    write /proc/sys/vm/min_free_kbytes 32768
    write /proc/sys/vm/lowmem_reserve_ratio "0 0 0"
    write /proc/sys/vm/vfs_cache_pressure 50
    write /proc/sys/vm/dirty_ratio 40
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/dirty_writeback_centisecs 300
    write /proc/sys/vm/dirty_expire_centisecs 1500
    write /proc/sys/vm/page-cluster 0

    # khugepaged tuning
    write /sys/kernel/mm/transparent_hugepage/enabled "madvise"

    # boot time fs tune - aggressive IO
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/nr_requests 256
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048
    write /sys/block/sda/queue/iostats 0
    write /sys/block/sda/queue/nr_requests 128
    write /sys/block/sda/queue/read_ahead_kb 2048
    write /sys/block/sda/queue/scheduler "mq-deadline"
    write /sys/block/sdb/queue/iostats 0
    write /sys/block/sdb/queue/nr_requests 128
    write /sys/block/sdb/queue/read_ahead_kb 2048
    write /sys/block/sdc/queue/iostats 0
    write /sys/block/sdc/queue/nr_requests 256
    write /sys/block/sdc/queue/read_ahead_kb 2048

on boot
    # boot perf. tune - maximum boost during boot
    write /dev/cpuctl/rt/cpu.uclamp.min 100
    write /dev/cpuctl/rt/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/system/cpu.uclamp.min 100
    write /dev/cpuctl/system/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/system-background/cpu.uclamp.min 100
    write /dev/cpuctl/system-background/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground/cpu.uclamp.min 100
    write /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground_window/cpu.uclamp.min 100
    write /dev/cpuctl/foreground_window/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/top-app/cpu.uclamp.min 100
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/background/cpu.uclamp.min 100
    write /dev/cpuctl/background/cpu.uclamp.latency_sensitive 1

on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.zram
    write /proc/sys/vm/swappiness 60

    # Re-enable storage clock gating once boot-critical work is done.
    write /sys/devices/platform/11270000.ufshci/clkgate_enable 1

    # restore boot perf. tune
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq 0
    write /sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq 0

# Configure clamps for standard task groups - aggressive for performance.
    write /dev/cpuctl/rt/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/rt/cpu.uclamp.max max
    write /dev/cpuctl/rt/cpu.uclamp.min 96
    write /dev/cpuctl/rt/cpu.shares 20480

    write /dev/cpuctl/system/cpu.shares 20480

    write /dev/cpuctl/system/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/system-background/cpu.uclamp.max 80
    write /dev/cpuctl/system-background/cpu.uclamp.min 0
    write /dev/cpuctl/system-background/cpu.shares 1024

    write /dev/cpuctl/background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/background/cpu.uclamp.max 60
    write /dev/cpuctl/background/cpu.uclamp.min 0
    write /dev/cpuctl/background/cpu.shares 512

    write /dev/cpuctl/foreground/cpu.uclamp.max max
    write /dev/cpuctl/foreground/cpu.uclamp.min 40
    write /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground/cpu.shares 20480

    write /dev/cpuctl/foreground_window/cpu.uclamp.max max
    write /dev/cpuctl/foreground_window/cpu.uclamp.min 40
    write /dev/cpuctl/foreground_window/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground_window/cpu.shares 20480

    write /dev/cpuctl/top-app/cpu.uclamp.max max
    write /dev/cpuctl/top-app/cpu.uclamp.min 60
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/top-app/cpu.shares 20480

    write /dev/cpuctl/nnapi-hal/cpu.uclamp.max max
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.min 100
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/nnapi-hal/cpu.shares 20480

    write /dev/cpuctl/camera-daemon/cpu.uclamp.max max
    write /dev/cpuctl/camera-daemon/cpu.uclamp.min 80
    write /dev/cpuctl/camera-daemon/cpu.shares 20480

    write /dev/cpuctl/dex2oat/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/dex2oat/cpu.uclamp.max 80
    write /dev/cpuctl/dex2oat/cpu.uclamp.min 0
    write /dev/cpuctl/dex2oat/cpu.shares 512

    write /proc/sys/kernel/sched_util_clamp_min_rt_default 96
    write /proc/sys/kernel/sched_util_clamp_min 192

    # Configure DVFS - aggressive
    write /sys/kernel/ged/hal/dvfs_margin_value 150

    # GPU performance tuning (ged hal nodes, value is an OPP index:
    # 0 = max 1068MHz, 44 = min 390MHz; verified on device)
    write /sys/kernel/ged/hal/custom_boost_gpu_freq 0
    write /sys/kernel/ged/hal/custom_upbound_gpu_freq 0

    # FPSGO enablement
    write /sys/kernel/fpsgo/fbt/enable_ceiling 1
    write /sys/kernel/fpsgo/fbt/blc_boost 1
    write /sys/kernel/fpsgo/fbt/boost_ta 1
    write /sys/kernel/fpsgo/fbt/switch_idleprefer 1
    write /sys/kernel/fpsgo/fbt/llf_task_policy 1
    write /sys/kernel/fpsgo/fbt/ultra_rescue 1

    setprop vendor.powerhal.init 1

service vendor.gralloc-4-0 /vendor/bin/hw/android.hardware.graphics.allocator@4.0-service-mediatek
    class hal animation
    interface android.hardware.graphics.allocator@4.0::IAllocator default
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ProcessCapacityHigh HighPerformance
    override

service vendor.hwcomposer-2-3 /vendor/bin/hw/android.hardware.graphics.composer@2.3-service
    override
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles HighPerformance
